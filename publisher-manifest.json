gap:18px;align-items:start}\n  .step .big{font-size:32px;font-weight:800;line-height:1;color:var(--brick);border-right:2px solid var(--line);padding-right:14px}\n  .step h3{margin:0 0 6px;font-size:17px}\n  .step p{margin:0;font-size:14.5px;color:var(--ink-soft)}\n\n  /* 套餐：纵向列表逐行展开 */\n  .plan-list{border-top:2px solid var(--line)}\n  .plan-row{display:grid;grid-template-columns:200px minmax(0,1fr) 168px;gap:clamp(16px,3vw,40px);padding:26px 0;border-bottom:2px solid var(--line);align-items:start}\n  .plan-row.featured{background:var(--paper);padding-left:18px;padding-right:18px;border-left:2px solid var(--brick);border-right:2px solid var(--brick)}\n  .plan-name{font-size:20px;font-weight:800;margin:0 0 6px}\n  .plan-tag{display:inline-block;font-size:11.5px;letter-spacing:.14em;border:2px solid var(--brick);color:var(--brick);padding:1px 7px;margin-bottom:10px}\n  .plan-note{font-size:13px;color:var(--ink-soft);line-height:1.7;margin:0}\n  .plan-feats{margin:0;padding:0;list-style:none;font-size:14.5px;columns:2;column-gap:26px}\n  .plan-feats li{margin-bottom:9px;padding-left:16px;position:relative;break-inside:avoid;color:var(--ink-soft)}\n  .plan-feats li::before{content:\"\";position:absolute;left:0;top:.62em;width:7px;height:7px;background:var(--brick)}\n  .plan-price{text-align:right}\n  .plan-price .p{font-size:26px;font-weight:800;display:block;line-height:1.2}\n  .plan-price .y{display:block;font-size:12.5px;color:var(--ink-soft);margin-top:6px;line-height:1.6}\n  .plan-price .y b{color:var(--brick);font-weight:700}\n  .plan-foot{margin-top:22px;font-size:13.5px;color:var(--ink-soft)}\n\n  /* FAQ 编号列表 */\n  .faq-list{counter-reset:faq;display:grid;gap:0;border-top:2px solid var(--line)}\n  .faq-item{counter-increment:faq;display:grid;grid-template-columns:58px minmax(0,1fr);gap:18px;padding:24px 0;border-bottom:2px solid var(--line)}\n  .faq-item::before{content:counter(faq,decimal-leading-zero);font-size:24px;font-weight:800;color:var(--brick);line-height:1.2;border-right:2px solid var(--sand);padding-right:12px}\n  .faq-item h3{margin:0 0 8px;font-size:17px;line-height:1.55}\n  .faq-item p{margin:0;font-size:14.8px;color:var(--ink-soft)}\n  .faq-item p + p{margin-top:10px}\n\n  /* 客户端区块 */\n  .client-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}\n  .client{border:2px solid var(--line);background:var(--paper);padding:22px}\n  .client h3{margin:0 0 4px;font-size:17px}\n  .client .sys{font-size:12px;letter-spacing:.16em;color:var(--brick);text-transform:uppercase;display:block;margin-bottom:12px}\n  .client p{font-size:14.2px;color:var(--ink-soft);margin:0 0 12px}\n  .client .get{font-size:13.5px;display:inline-block;border-bottom:2px solid var(--brick)}\n  .client .get.plain{border-bottom:0;color:var(--ink-soft)}\n\n  .closing{background:var(--ink);color:var(--cream);padding:clamp(40px,6vw,70px) clamp(22px,5vw,72px)}\n  .closing h2{font-size:clamp(22px,3.2vw,34px);margin:0 0 18px;line-height:1.3}\n  .closing p{max-width:60ch;color:#d9cfc2}\n  .closing a{color:#f0c98f}\n  footer{padding:26px clamp(22px,5vw,72px) 40px;font-size:12.8px;color:var(--ink-soft);border-top:2px solid var(--line);background:var(--paper)}\n\n  @media (max-width:880px){\n    .shell{grid-template-columns:1fr}\n    .rail{position:static;height:auto;border-right:0;border-bottom:2px solid var(--line);padding:22px 20px 18px}\n    .rail nav{margin-top:16px;flex-direction:row;flex-wrap:wrap;gap:6px 16px}\n    .rail nav a{border-left:0;padding:4px 0;border-bottom:2px solid transparent}\n    .rail nav a:hover{border-left:0;border-bottom-color:var(--brick)}\n    .rail .rail-note{display:none}\n    .intro-grid{grid-template-columns:1fr}\n    .plan-row{grid-template-columns:1fr;gap:14px}\n    .plan-feats{columns:1}\n    .plan-price{text-align:left}\n    .step{grid-template-columns:44px minmax(0,1fr);gap:14px}\n    .step .big{font-size:24px;padding-right:10px}\n    .faq-item{grid-template-columns:40px minmax(0,1fr);gap:12px}\n  }\n</style><div class=\"shell\">\n  <aside class=\"rail\">\n    <a class=\"mark\" href=\"#top\">一元机场<span>ONE YUAN</span></a>\n    <nav aria-label=\"页面目录\">\n      <a href=\"#start\">先聊两句</a>\n      <a href=\"#howto\">怎么用起来</a>\n      <a href=\"#plans\">套餐怎么挑</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#contact\">最后交代</a>\n    </nav>\n    <div class=\"rail-note\">\n      这是一份说明页，不是下单页。价格、权益、设备数都写在下面，读到哪一步都可以先停一停。\n    </div>\n  </aside>\n\n  <main id=\"top\">\n    <div class=\"band band-cream\">\n      <h1>别急着买，先把一元机场的规矩看清楚<span class=\"thin\">价格与权益逐条摊开</span></h1>\n      <p class=\"lede\">朋友之间推荐一样东西，通常先讲麻烦在哪。这里也是一样：先告诉你要花多少钱、能连几台设备、用不上怎么办，然后再把入口给你。</p>\n    </div>\n\n    <div class=\"band band-sand\">\n      <div class=\"strips\">\n        <div>\n          <h3>起步价</h3>\n          <p>基础版 ¥15 / 月，年付 ¥150。先按月试，比一次性押一年更稳妥。</p>\n        </div>\n        <div>\n          <h3>设备数</h3>\n          <p>从 3 台到 20 台，按你家里实际要连的手机、电脑、平板来数。</p>\n        </div>\n        <div>\n          <h3>流量额度</h3>\n          <p>每月 100GB 起，往上 300GB、1000GB。额度写在套餐行里，不做模糊表述。</p>\n        </div>\n        <div>\n          <h3>怎么联系</h3>\n          <p>套餐内的支持方式按版本区分，旗舰版含优先工单，团队版配专属客户经理。</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"band band-brick\">\n      <p class=\"lede\">\n        <strong>三分钟能读完的内容，不写成三十页。</strong>下面每个区块都只回答一个问题：这一步你该做什么，以及做完之后能得到什么。\n      </p>\n    </div>\n\n    <section id=\"start\">\n      <div class=\"sec-head\">\n        <span class=\"num\">01</span>\n        <h2>先聊两句：这页是给谁看的</h2>\n        <span class=\"kicker\">读起来像在和同事聊</span>\n      </div>\n      <div class=\"intro-grid\">\n        <div>\n          <p>如果你正在找一份能把套餐价格、设备数量和流量额度一次说清的说明，那这页就是为你准备的。我们把三档套餐逐行排开，不做花哨的对比图，也不在角落里塞小字。</p>\n          <p>如果你只是想先知道「有没有便宜的入门选择」，答案在套餐区第一行。如果你想给一个小团队统一安排，第三行更合适。中间那档是我们自己用着最顺手的版本，所以单独做了标记。</p>\n          <p>再说一句实在话：我们提供的是一份按版本区分额度与服务方式的订阅，具体能连哪些设备、每月额度怎么算，都以页面写明的内容为准。没有写的东西，请不要替我们想象。</p>\n        </div>\n        <aside class=\"aside-box\">\n          <h3>三件先确认的事</h3>\n          <ul>\n            <li>你打算同时连几台设备？先数清楚再选版本。</li>\n            <li>你主要在家用还是移动中使用？线路各有侧重。</li>\n            <li>你更愿意按月付还是按年付？年付更省，但需要先接受周期。</li>\n          </ul>\n          <p>想好这三件事，选套餐基本不会错。</p>\n        </aside>\n      </div>\n    </section>\n\n    <section id=\"howto\">\n      <div class=\"sec-head\">\n        <span class=\"num\">02</span>\n        <h2>怎么用起来：四步，不绕路</h2>\n        <span class=\"kicker\">照着做就行</span>\n      </div>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"big\">1</div>\n          <div>\n            <h3>先看版本，不看价格</h3>\n            <p>打开下面的套餐区，从上往下读一遍权益。价格放在最后看，因为选错版本再多省几十块也不划算。</p>\n          </div>\n        </article>\n        <article class=\"step\">\n          <div class=\"big\">2</div>\n          <div>\n            <h3>对应你的设备数量</h3>\n            <p>基础版给 3 台，旗舰版给 5 台，团队版给 20 台。把家里或团队里实际要连的设备列一遍，别按「可能」算。</p>\n          </div>\n        </article>\n        <article class=\"step\">\n          <div class=\"big\">3</div>\n          <div>\n            <h3>装客户端，选对应系统</h3>\n            <p>客户端区块按桌面与移动系统分别列出，每个系统后面写了配置时该注意的一点。没有提供下载地址的系统，我们不做虚假链接。</p>\n          </div>\n        </article>\n        <article class=\"step\">\n          <div class=\"big\">4</div>\n          <div>\n            <h3>用一周再决定要不要年付</h3>\n            <p>月付是第一道试用门槛。一周之后你觉得额度够、线路顺，再考虑把周期拉长到一年，这样更稳。</p>\n          </div>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"plans\">\n      <div class=\"sec-head\">\n        <span class=\"num\">03</span>\n        <h2>套餐怎么挑：三行，逐行展开</h2>\n        <span class=\"kicker\">价格与权益写在同一条线上</span>\n      </div>\n\n      <div class=\"plan-list\">\n        <article class=\"plan-row\">\n          <div>\n            <h3 class=\"plan-name\">基础版</h3>\n            <p class=\"plan-note\">适合一个人、两三台设备、主要看视频和查资料。</p>\n          </div>\n          <ul class=\"plan-feats\">\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"p\">¥15 / 月</span>\n            <span class=\"y\">按年付 <b>¥150 / 年</b></span>\n          </div>\n        </article>\n\n        <article class=\"plan-row featured\">\n          <div>\n            <span class=\"plan-tag\">我们常用这档</span>\n            <h3 class=\"plan-name\">旗舰版</h3>\n            <p class=\"plan-note\">三四台设备加一台常开的电脑，通常落在这个版本。</p>\n          </div>\n          <ul class=\"plan-feats\">\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"p\">¥35 / 月</span>\n            <span class=\"y\">按年付 <b>¥350 / 年</b></span>\n          </div>\n        </article>\n\n        <article class=\"plan-row\">\n          <div>\n            <h3 class=\"plan-name\">团队版</h3>\n            <p class=\"plan-note\">给需要统一安排的小团队，按席位共享同一份额度。</p>\n          </div>\n          <ul class=\"plan-feats\">\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"p\">¥85 / 月</span>\n            <span class=\"y\">按年付 <b>¥850 / 年</b></span>\n          </div>\n        </article>\n      </div>\n      <p class=\"plan-foot\">价格与权益以上表为准。年付需要先接受一整年周期，所以建议先用月付走过一个完整使用周再决定。表中未列出的能力，我们不额外承诺。</p>\n    </section>\n\n    <section id=\"clients\">\n      <div class=\"sec-head\">\n        <span class=\"num\">04</span>\n        <h2>客户端：按系统找，不混着装</h2>\n        <span class=\"kicker\">一共四类常见环境</span>\n      </div>\n      <div class=\"client-grid\">\n        <article class=\"client\">\n          <h3>桌面端 · Windows</h3>\n          <span class=\"sys\">Windows 10 及以上</span>\n          <p>装好后先确认系统托盘里能看到图标，再导入配置。若提示权限不足，用管理员身份重开一次即可。</p>\n          <span class=\"get plain\">下载入口以页面后续公布为准</span>\n        </article>\n        <article class=\"client\">\n          <h3>桌面端 · macOS</h3>\n          <span class=\"sys\">macOS 12 及以上</span>\n          <p>首次启动需要在系统设置里手动允许网络扩展，这一步不做会一直显示未连接。</p>\n          <span class=\"get plain\">下载入口以页面后续公布为准</span>\n        </article>\n        <article class=\"client\">\n          <h3>移动端 · iOS</h3>\n          <span class=\"sys\">iPhone / iPad</span>\n          <p>从 App Store 对应条目安装，导入配置后回到主界面确认开关状态，避免只在后台待机。</p>\n          <span class=\"get plain\">下载入口以页面后续公布为准</span>\n        </article>\n        <article class=\"client\">\n          <h3>移动端 · Android</h3>\n          <span class=\"sys\">Android 9 及以上</span>\n          <p>安装时系统可能提示未知来源，按提示允许一次即可。配置导入后建议先看连接日志是否正常。</p>\n          <span class=\"get plain\">下载入口以页面后续公布为准</span>\n        </article>\n      </div>\n      <p>我们没有在这些条目里放具体下载链接，因为地址会随版本更新。等你真正要装的时候，以届时页面上给出的入口为准，不轻信第三方转发的安装包。</p>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"sec-head\">\n        <span class=\"num\">05</span>\n        <h2>常见问题：编号挨个答</h2>\n        <span class=\"kicker\">按问到最多的顺序排</span>\n      </div>\n      <div class=\"faq-list\">\n        <article class=\"faq-item\">\n          <div>\n            <h3>我现在只有一台手机，需要买旗舰版吗？</h3>\n            <p>不必。基础版给 3 台设备、每月 100GB，一个人用手机加偶尔开电脑，通常够。等设备数到四台以上，再考虑旗舰版。</p>\n          </div>\n        </article>\n        <article class=\"faq-item\">\n          <div>\n            <h3>年付比月付省多少？</h3>\n            <p>基础版年付 ¥150，相当于十个月的价格；旗舰版 ¥350；团队版 ¥850。省下的额度一样，但因为要一次性付满一年，建议先用月付确认一周。</p>\n          </div>\n        </article>\n        <article class=\"faq-item\">\n          <div>\n            <h3>同时在线设备数怎么算？</h3>\n            <p>按同一时间保持连接的设备台数计算。手机、电脑、平板各算一台。基础版上限 3 台，旗舰版 5 台，团队版 20 台，超出时请先断开闲置设备。</p>\n          </div>\n        </article>\n        <article class=\"faq-item\">\n          <div>\n            <h3>每月流量用不完会结转到下个月吗？</h3>\n            <p>页面没有给出结转规则，所以我们不在这里替它下结论。请以你实际购买时看到的条款为准，不要按「能攒」来做规划。</p>\n          </div>\n        </article>\n        <article class=\"faq-item\">\n          <div>\n            <h3>装好客户端却显示未连接，先查哪里？</h3>\n            <p>先看三件事：配置是否完整导入、系统是否允许了网络扩展、开关是不是真的处于开启状态。macOS 和 iOS 上最常见的卡点就是权限没放行。</p>\n          </div>\n        </article>\n        <article class=\"faq-item\">\n          <div>\n            <h3>团队版和个人版差别只在设备数吗？</h3>\n            <p>不止。团队版把额度提到每月 1000GB、设备数提到 20 台，并且包含 VIP 高带宽节点、企业定制路由与专属客户经理。个人用不到这些，就不必往上买。</p>\n          </div>\n        </article>\n        <article class=\"faq-item\">\n          <div>\n            <h3>遇到问题走哪个支持渠道？</h3>\n            <p>旗舰版包含 7×24 优先工单支持，团队版有专属客户经理对接；基础版走常规支持。具体提交通道以你购买后页面给出的入口为准。</p>\n          </div>\n        </article>\n        <article class=\"faq-item\">\n          <div>\n            <h3>可以先试再买吗？</h3>\n            <p>我们没有在页面上承诺免费试用。比较稳妥的做法是先用一个月付的基础版，自己感受额度与线路，再决定是否升档或转年付。</p>\n          </div>\n        </article>\n      </div>\n    </section>\n\n    <div class=\"closing\" id=\"contact\">\n      <h2>最后交代一句：把不确定的地方问清楚，再付钱。</h2>\n      <p>这份说明只负责把价格、设备数、流量额度与客户端安装方式写清楚。凡是页面没提到的，比如节点所在地区、长期可用性、退款条件，请你在购买前直接向官方渠道确认，别拿我们的推测当依据。</p>\n      <p>如果你已经想好选哪一档，回到上面的套餐区，按那一行的权益再核一遍设备数即可。<a href=\"#plans\">回到套餐</a>　·　<a href=\"#faq\">再看一遍常见问题</a></p>\n    </div>\n\n    <footer>\n      一元机场 · 本页为套餐与使用说明，价格与权益以页面所列内容为准。文中未列出的事项不做额外承诺。\n    </footer>\n  </main>\n</div>",
